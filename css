:root{
  --bg:#f7f8fc;--surface:#fff;--text:#111827;--muted:#667085;--line:#e7e9ef;
  --primary:#5b4bff;--primary-dark:#4638dc;--accent:#eef0ff;--dark:#11142a;
  --shadow:0 18px 45px rgba(20,24,60,.08);--radius:22px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
a{text-decoration:none;color:inherit}
button,input{font:inherit}
.container{width:min(1160px,92%);margin:auto}
.site-header{height:76px;background:rgba(255,255,255,.9);backdrop-filter:blur(14px);border-bottom:1px solid var(--line);position:sticky;top:0;z-index:20}
.nav-wrap{height:100%;display:flex;align-items:center;gap:28px}
.brand{display:flex;align-items:center;gap:9px;font-size:19px;white-space:nowrap}
.brand-mark{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:var(--primary);color:white;font-weight:800}
.brand strong{font-weight:800}
.main-nav{display:flex;align-items:center;gap:25px;margin-left:auto}
.main-nav a{font-size:14px;color:#606878;font-weight:600}
.main-nav a:hover,.main-nav a.active{color:var(--primary)}
.nav-cta{background:var(--dark);color:white;padding:10px 17px;border-radius:11px;font-size:14px;font-weight:700}
.menu-toggle{display:none;background:none;border:0;font-size:25px}
.hero{padding:78px 0 65px;background:linear-gradient(135deg,#f8f8ff 0%,#fff 50%,#f1f0ff 100%);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:60px;align-items:center}
.eyebrow{font-size:11px;letter-spacing:1.6px;font-weight:800;color:var(--primary)}
.hero h1{font-size:clamp(43px,6vw,72px);line-height:1.03;letter-spacing:-3px;margin:14px 0 20px;max-width:700px}
.hero h1 span{color:var(--primary)}
.hero-copy>p{font-size:18px;color:var(--muted);max-width:600px}
.hero-actions{display:flex;gap:12px;margin:30px 0}
.btn{display:inline-flex;align-items:center;justify-content:center;padding:13px 20px;border-radius:12px;font-weight:750;font-size:14px;border:1px solid transparent;transition:.2s}
.btn.primary{background:var(--primary);color:#fff}.btn.primary:hover{background:var(--primary-dark);transform:translateY(-1px)}
.btn.secondary{background:white;border-color:var(--line)}.btn.secondary:hover{border-color:#c7c9d5}
.btn.light{background:white;color:var(--dark)}
.hero-stats{display:flex;gap:35px;padding-top:10px}.hero-stats div{display:flex;flex-direction:column}.hero-stats strong{font-size:16px}.hero-stats span{font-size:12px;color:var(--muted)}
.hero-card{min-height:420px;border-radius:30px;background:var(--dark);color:white;padding:34px;position:relative;overflow:hidden;box-shadow:var(--shadow)}
.hero-card:before{content:"";position:absolute;width:330px;height:330px;border-radius:50%;background:#5145dc;right:-100px;top:-90px;opacity:.75}
.hero-card:after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;background:#7c70ff;left:-90px;bottom:-120px;opacity:.25}
.hero-card-top{display:flex;justify-content:space-between;position:relative;z-index:2}.mini-badge{font-size:10px;letter-spacing:1.4px;font-weight:800}.dot{width:8px;height:8px;background:#8cffc1;border-radius:50%;margin-top:5px}
.hero-card h2{font-size:39px;line-height:1.08;letter-spacing:-1.5px;margin:65px 0 10px;position:relative;z-index:2}.hero-card h2 span{color:#aaa3ff}
.hero-card p{color:#c8cad7;position:relative;z-index:2}
.floating-card{position:absolute;background:rgba(255,255,255,.97);color:#202236;border-radius:14px;padding:13px 15px;box-shadow:0 15px 30px rgba(0,0,0,.18);font-size:13px;font-weight:700;display:flex;gap:10px;align-items:center;z-index:3}
.card-one{left:30px;bottom:40px}.card-two{right:24px;bottom:103px}.card-three{right:50px;bottom:36px}
.section{padding:78px 0}.search-section{padding:0;margin-top:-1px}
.search-box{background:white;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow);display:flex;align-items:center;padding:7px 8px 7px 18px}
.search-box>span{font-size:27px;color:#9298a8}.search-box input{border:0;outline:0;flex:1;padding:11px;font-size:14px;min-width:0}.search-box button{border:0;background:var(--dark);color:white;padding:11px 19px;border-radius:10px;font-weight:700;cursor:pointer}
.search-results{margin-top:8px;background:white;border:1px solid var(--line);border-radius:14px;padding:12px;box-shadow:var(--shadow)}
.search-results a{display:block;padding:10px 12px;border-radius:9px}.search-results a:hover{background:var(--accent)}.hidden{display:none}
.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:28px}.section-heading h2{font-size:31px;letter-spacing:-1px;margin-top:5px}.text-link{font-size:13px;font-weight:700;color:var(--primary)}
.feature-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:17px}.feature-card{background:white;border:1px solid var(--line);border-radius:var(--radius);padding:25px;transition:.22s}.feature-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:#d9d5ff}.icon-box{width:48px;height:48px;border-radius:14px;background:var(--accent);display:grid;place-items:center;font-size:22px;margin-bottom:22px}.feature-card h3{font-size:17px;margin-bottom:7px}.feature-card p{font-size:13px;color:var(--muted);min-height:64px}.feature-card span{font-size:12px;color:var(--primary);font-weight:800}
.semester-section{background:white}.semester-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:10px}.semester-grid a{border:1px solid var(--line);border-radius:16px;padding:18px 10px;text-align:center;transition:.2s}.semester-grid a:hover{background:var(--primary);color:white;transform:translateY(-2px)}.semester-grid strong{display:block;font-size:22px}.semester-grid span{font-size:10px;color:var(--muted)}.semester-grid a:hover span{color:#ddd}
.two-col{display:grid;grid-template-columns:.85fr 1.15fr;gap:70px;align-items:center}.two-col h2{font-size:39px;line-height:1.1;letter-spacing:-1.5px;margin:8px 0 12px}.muted{color:var(--muted);font-size:15px}.two-col .btn{margin-top:25px}
.update-list{display:flex;flex-direction:column;gap:13px}.update-list article{background:white;border:1px solid var(--line);border-radius:16px;padding:18px;display:flex;gap:17px}.update-list article>span{font-weight:900;color:var(--primary);font-size:12px}.update-list strong{font-size:15px}.update-list p{font-size:12px;color:var(--muted);margin-top:2px}
.cta-section{padding-top:15px}.cta-card{background:var(--dark);border-radius:27px;padding:42px 48px;color:white;display:flex;align-items:center;justify-content:space-between;gap:25px}.cta-card h2{font-size:31px;margin:4px 0}.cta-card p{color:#c4c6d1;font-size:14px}
.site-footer{background:#fff;border-top:1px solid var(--line);padding:55px 0 22px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:40px}.footer-brand{margin-bottom:12px}.footer-grid p{font-size:13px;color:var(--muted);max-width:340px}.footer-grid h4{font-size:13px;margin-bottom:12px}.footer-grid>div>a:not(.brand){display:block;font-size:13px;color:var(--muted);margin:6px 0}.footer-grid>div>a:hover{color:var(--primary)}.footer-bottom{border-top:1px solid var(--line);margin-top:35px;padding-top:18px;display:flex;justify-content:space-between;color:#89909e;font-size:11px}
.page-hero{padding:58px 0 48px;background:linear-gradient(135deg,#f8f8ff,#fff)}.page-hero h1{font-size:47px;letter-spacing:-2px;line-height:1.08;margin:8px 0}.page-hero p{color:var(--muted);max-width:650px}
.filter-bar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:25px}.filter-bar select,.filter-bar input{border:1px solid var(--line);background:white;border-radius:10px;padding:10px 12px;outline:none}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.resource-card{background:white;border:1px solid var(--line);border-radius:18px;padding:22px}.resource-card h3{font-size:16px;margin:8px 0}.resource-card p{font-size:12px;color:var(--muted);min-height:44px}.tag{display:inline-block;background:var(--accent);color:var(--primary);font-size:10px;font-weight:800;padding:4px 8px;border-radius:99px}.resource-card .card-link{display:inline-block;margin-top:15px;color:var(--primary);font-size:12px;font-weight:800}
.notice{padding:16px 18px;background:#f0efff;border:1px solid #ddd9ff;border-radius:14px;color:#4238a4;font-size:13px;margin-bottom:25px}
.form-card{background:white;border:1px solid var(--line);border-radius:20px;padding:28px;max-width:720px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.form-group{display:flex;flex-direction:column;gap:6px}.form-group.full{grid-column:1/-1}.form-group label{font-size:12px;font-weight:800}.form-group input,.form-group select,.form-group textarea{border:1px solid var(--line);border-radius:10px;padding:11px;outline:none}.form-group textarea{min-height:140px;resize:vertical}
@media(max-width:900px){.hero-grid,.two-col{grid-template-columns:1fr}.hero-card{min-height:350px}.feature-grid{grid-template-columns:repeat(2,1fr)}.semester-grid{grid-template-columns:repeat(4,1fr)}.resource-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:700px){.site-header{height:68px}.main-nav{display:none;position:absolute;left:4%;right:4%;top:63px;background:white;border:1px solid var(--line);border-radius:14px;padding:15px;box-shadow:var(--shadow);flex-direction:column;align-items:flex-start}.main-nav.open{display:flex}.menu-toggle{display:block;margin-left:auto}.nav-cta{display:none}.hero{padding:55px 0}.hero h1{font-size:47px}.hero-card h2{margin-top:45px}.hero-stats{gap:20px}.section{padding:58px 0}.feature-grid,.resource-grid{grid-template-columns:1fr}.semester-grid{grid-template-columns:repeat(2,1fr)}.section-heading{align-items:flex-start;gap:12px;flex-direction:column}.cta-card{padding:30px;flex-direction:column;align-items:flex-start}.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}.footer-bottom{flex-direction:column;gap:5px}.form-grid{grid-template-columns:1fr}.form-group.full{grid-column:auto}}

